TZ=UTC
DSM_URL=http://127.0.0.1:5000
DSM_USERNAME=your_dsm_username
DSM_PASSWORD=
DSM_VERIFY_SSL=true
DSM_DEVICE_NAME=SynologyPhotosThumbGen
# Run `id` on your Synology NAS to check your UID/GID
PUID=1000
PGID=100
PHOTOS_HOST_DIR=/volume1/homes/your_dsm_username/Photos
PHOTOS_DIR=/photos
DATA_DIR=/data
POLL_INTERVAL_SECONDS=1800
WATCH_ENABLED=true
WATCH_DEBOUNCE_SECONDS=15
WATCH_FOLLOWUP_SECONDS=45
JPEG_QUALITY=90
ALLOW_DOWNLOAD_FALLBACK=true
MARK_BROKEN_ON_ERROR=false
LOG_LEVEL=INFO
